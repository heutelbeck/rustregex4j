<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0">
    <!-- The group names are an immutable list from List.copyOf; SpotBugs cannot see that. -->
    <Match>
        <Class name="com.heutelbeck.rustregex4j.Regex"/>
        <Method name="groupNames"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
</FindBugsFilter>
