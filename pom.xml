<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.heutelbeck</groupId>
    <artifactId>rustregex4j</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>rustregex4j</name>
    <description>Linear-time regular expressions for Java, matched by the Rust regex crate: thread-safe, with bounded worst-case cost and results identical to Rust programs using the same crate.</description>
    <url>https://github.com/heutelbeck/rustregex4j</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/mit</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Dominic Heutelbeck</name>
            <organizationUrl>https://heutelbeck.com</organizationUrl>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/heutelbeck/rustregex4j</url>
        <connection>scm:git:https://github.com/heutelbeck/rustregex4j.git</connection>
        <developerConnection>scm:git:git@github.com:heutelbeck/rustregex4j.git</developerConnection>
    </scm>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <lombok.version>1.18.48</lombok.version>
        <junit.version>6.1.3</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <native.buildtools.version>1.1.19</native.buildtools.version>
        <graalvm.sdk.version>25.0.5</graalvm.sdk.version>
        <!-- JaCoCo prepends its agent; empty when the agent is not prepared, as in a plain
             surefire:test. -->
        <argLine />
        <spotbugs.plugin.version>4.10.5.0</spotbugs.plugin.version>
        <jacoco.version>0.8.16</jacoco.version>
        <javadoc.plugin.version>3.12.0</javadoc.plugin.version>
        <!-- Directory with the engine libraries of all platforms, one subdirectory per
             platform; set by the release build, which assembles the libraries built on
             each platform. Without it, the build compiles the engine for this platform. -->
        <engine.libraries />
        <engine.skip>false</engine.skip>
        <engine.tests.skip>${engine.skip}</engine.tests.skip>
        <engine.target.directory>${project.build.directory}/engine</engine.target.directory>
        <engine.resource.directory>${project.build.outputDirectory}/com/heutelbeck/rustregex4j/engine</engine.resource.directory>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Public API of the GraalVM image builder, for StaticEngineFeature; the image builder
             provides it at build time of a native image. -->
        <dependency>
            <groupId>org.graalvm.sdk</groupId>
            <artifactId>nativeimage</artifactId>
            <version>${graalvm.sdk.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>LICENSE</include>
                </includes>
            </resource>
        </resources>
        <extensions>
            <!-- Provides ${os.detected.classifier}, for example linux-x86_64 or osx-aarch_64. -->
            <extension>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>1.7.1</version>
            </extension>
        </extensions>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.7.0</version>
                <executions>
                    <execution>
                        <id>build-engine</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${engine.skip}</skip>
                            <executable>cargo</executable>
                            <workingDirectory>${project.basedir}/engine</workingDirectory>
                            <arguments>
                                <argument>build</argument>
                                <argument>--release</argument>
                                <argument>--locked</argument>
                                <argument>--manifest-path</argument>
                                <argument>${project.basedir}/engine/Cargo.toml</argument>
                                <argument>--target-dir</argument>
                                <argument>${engine.target.directory}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>test-engine</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${engine.tests.skip}</skip>
                            <executable>cargo</executable>
                            <workingDirectory>${project.basedir}/engine</workingDirectory>
                            <arguments>
                                <argument>test</argument>
                                <argument>--release</argument>
                                <argument>--locked</argument>
                                <argument>--manifest-path</argument>
                                <argument>${project.basedir}/engine/Cargo.toml</argument>
                                <argument>--target-dir</argument>
                                <argument>${engine.target.directory}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>bundle-engine</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <skip>${engine.skip}</skip>
                            <outputDirectory>${engine.resource.directory}/${os.detected.classifier}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${engine.target.directory}/release</directory>
                                    <includes>
                                        <include>librustregex4j.so</include>
                                        <include>librustregex4j.dylib</include>
                                        <include>rustregex4j.dll</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:all,-processing</arg>
                    </compilerArgs>
                    <failOnWarning>true</failOnWarning>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
                <configuration>
                    <!-- argLine of JaCoCo first; the engine needs native access. -->
                    <argLine>@{argLine} --enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <!-- Quality gates of verify: SpotBugs at the highest effort and lowest threshold,
                 Javadoc without any warning, and a minimum test coverage. -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs.plugin.version}</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Low</threshold>
                    <excludeFilterFile>${project.basedir}/spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${javadoc.plugin.version}</version>
                <configuration>
                    <doclint>all</doclint>
                    <failOnWarnings>true</failOnWarnings>
                </configuration>
                <executions>
                    <execution>
                        <id>javadoc-lint</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>javadoc-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- StaticEngineFeature runs only inside the GraalVM image builder; the native
                 image tests prove it, the JVM tests cannot reach it. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <exclude>com/heutelbeck/rustregex4j/StaticEngineFeature*</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>coverage-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>coverage-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.85</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- On Linux x86_64, also builds the static engine library against musl, which
             StaticEngineFeature links into fully static native images. -->
        <profile>
            <id>static-engine</id>
            <activation>
                <os>
                    <name>linux</name>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <engine.static.target>x86_64-unknown-linux-musl</engine.static.target>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>build-static-engine</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${engine.skip}</skip>
                                    <executable>cargo</executable>
                                    <workingDirectory>${project.basedir}/engine</workingDirectory>
                                    <arguments>
                                        <argument>rustc</argument>
                                        <argument>--release</argument>
                                        <argument>--locked</argument>
                                        <argument>--lib</argument>
                                        <argument>--crate-type</argument>
                                        <argument>staticlib</argument>
                                        <argument>--target</argument>
                                        <argument>${engine.static.target}</argument>
                                        <argument>--manifest-path</argument>
                                        <argument>${project.basedir}/engine/Cargo.toml</argument>
                                        <argument>--target-dir</argument>
                                        <argument>${engine.target.directory}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>bundle-static-engine</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <skip>${engine.skip}</skip>
                                    <outputDirectory>${engine.resource.directory}/${os.detected.classifier}-musl</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${engine.target.directory}/${engine.static.target}/release</directory>
                                            <includes>
                                                <include>librustregex4j.a</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Name the Rust architecture of the Linux build machine for the portable Linux engines. -->
        <profile>
            <id>linux-x86_64</id>
            <activation>
                <os>
                    <name>linux</name>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <engine.rust.arch>x86_64</engine.rust.arch>
            </properties>
        </profile>
        <profile>
            <id>linux-aarch64</id>
            <activation>
                <os>
                    <name>linux</name>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <engine.rust.arch>aarch64</engine.rust.arch>
            </properties>
        </profile>
        <!-- Builds the Linux engines that run beyond the build machine, with cargo-zigbuild and
             zig: the glibc engine against glibc 2.17 instead of the glibc of the build machine,
             and in addition a shared engine against musl for JVMs on musl systems such as
             Alpine. Needs Linux, zig, cargo-zigbuild and the Rust targets
             <arch>-unknown-linux-gnu and <arch>-unknown-linux-musl: mvn -Pportable-linux-engines verify -->
        <profile>
            <id>portable-linux-engines</id>
            <properties>
                <engine.glibc.target>${engine.rust.arch}-unknown-linux-gnu</engine.glibc.target>
                <engine.musl.target>${engine.rust.arch}-unknown-linux-musl</engine.musl.target>
                <engine.musl.target.directory>${project.build.directory}/engine-musl</engine.musl.target.directory>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>build-engine</id>
                                <configuration>
                                    <arguments combine.self="override">
                                        <argument>zigbuild</argument>
                                        <argument>--release</argument>
                                        <argument>--locked</argument>
                                        <argument>--lib</argument>
                                        <argument>--target</argument>
                                        <argument>${engine.glibc.target}.2.17</argument>
                                        <argument>--manifest-path</argument>
                                        <argument>${project.basedir}/engine/Cargo.toml</argument>
                                        <argument>--target-dir</argument>
                                        <argument>${engine.target.directory}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>build-musl-engine</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${engine.skip}</skip>
                                    <executable>cargo</executable>
                                    <workingDirectory>${project.basedir}/engine</workingDirectory>
                                    <!-- A shared library links the C library of musl dynamically. -->
                                    <environmentVariables>
                                        <RUSTFLAGS>-C target-feature=-crt-static</RUSTFLAGS>
                                    </environmentVariables>
                                    <arguments>
                                        <argument>zigbuild</argument>
                                        <argument>--release</argument>
                                        <argument>--locked</argument>
                                        <argument>--lib</argument>
                                        <argument>--target</argument>
                                        <argument>${engine.musl.target}</argument>
                                        <argument>--manifest-path</argument>
                                        <argument>${project.basedir}/engine/Cargo.toml</argument>
                                        <argument>--target-dir</argument>
                                        <argument>${engine.musl.target.directory}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>bundle-engine</id>
                                <configuration>
                                    <resources combine.self="override">
                                        <resource>
                                            <directory>${engine.target.directory}/${engine.glibc.target}/release</directory>
                                            <includes>
                                                <include>librustregex4j.so</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>bundle-musl-engine</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <skip>${engine.skip}</skip>
                                    <outputDirectory>${engine.resource.directory}/${os.detected.classifier}-musl</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${engine.musl.target.directory}/${engine.musl.target}/release</directory>
                                            <includes>
                                                <include>librustregex4j.so</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Bundles prebuilt engine libraries of all platforms instead of compiling the engine:
             mvn -Pprebuilt-engines -Dengine.libraries=<directory> package -->
        <profile>
            <id>prebuilt-engines</id>
            <properties>
                <engine.skip>true</engine.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>bundle-prebuilt-engines</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${engine.resource.directory}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${engine.libraries}</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Runs the test suite as a GraalVM native image: mvn -Pnative test -->
        <profile>
            <id>native</id>
            <dependencies>
                <dependency>
                    <groupId>org.junit.platform</groupId>
                    <artifactId>junit-platform-launcher</artifactId>
                    <version>${junit.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${native.buildtools.version}</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>native-test</id>
                                <goals>
                                    <goal>test</goal>
                                </goals>
                                <phase>test</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Runs the test suite as a fully static GraalVM native image with the engine linked in;
             needs GraalVM with musl support: mvn -Pnative-static test -->
        <profile>
            <id>native-static</id>
            <dependencies>
                <dependency>
                    <groupId>org.junit.platform</groupId>
                    <artifactId>junit-platform-launcher</artifactId>
                    <version>${junit.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${native.buildtools.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <buildArgs>
                                <buildArg>--static</buildArg>
                                <buildArg>--libc=musl</buildArg>
                                <buildArg>--features=com.heutelbeck.rustregex4j.StaticEngineFeature</buildArg>
                            </buildArgs>
                        </configuration>
                        <executions>
                            <execution>
                                <id>native-test</id>
                                <goals>
                                    <goal>test</goal>
                                </goals>
                                <phase>test</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Runs the test suite as a mostly static GraalVM native image, which links everything
             but the C library statically and loads the engine library at run time:
             mvn -Pnative-mostly-static test -->
        <profile>
            <id>native-mostly-static</id>
            <dependencies>
                <dependency>
                    <groupId>org.junit.platform</groupId>
                    <artifactId>junit-platform-launcher</artifactId>
                    <version>${junit.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${native.buildtools.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <buildArgs>
                                <buildArg>--static-nolibc</buildArg>
                            </buildArgs>
                        </configuration>
                        <executions>
                            <execution>
                                <id>native-test</id>
                                <goals>
                                    <goal>test</goal>
                                </goals>
                                <phase>test</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Signs and publishes to Maven Central; snapshots go to the Central snapshot repository:
             mvn -Prelease deploy -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${javadoc.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
